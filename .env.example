# --- База данных (Neon) ---
# Pooled-строка (хост с "-pooler") — для приложения
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Прямая строка (без "-pooler") — для миграций
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Админка ---
ADMIN_PASSWORD="change-me"
# Любая длинная случайная строка (подпись cookie сессии)
AUTH_SECRET="replace-with-long-random-string"

# --- Telegram ---
TELEGRAM_BOT_TOKEN="123456:ABC..."
# Секрет, который Telegram присылает в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET="replace-with-random-string"

# --- Google Sheets (Apps Script Web App), необязательно ---
SHEETS_WEBHOOK_URL=""
SHEETS_SECRET=""

# --- Vercel Cron (Vercel подставляет его в Authorization: Bearer ...) ---
CRON_SECRET="replace-with-random-string"
